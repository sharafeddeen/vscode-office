{
  "name": "ahmed-spreadsheet-viewer",
  "displayName": "Ahmed Spreadsheet Viewer",
  "description": "Office Viewer spreadsheet editing, saved formula results and native recalculation.",
  "version": "0.2.1",
  "publisher": "sharafeddeen",
  "icon": "image/logo.png",
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=24"
  },
  "keywords": [
    "pdf",
    "word",
    "docx",
    "excel",
    "xlsx",
    "csv",
    "tsv",
    "powerpoint",
    "pptx",
    "markdown",
    "epub",
    "svg",
    "psd",
    "xmind",
    "parquet",
    "zip",
    "archive",
    "font",
    "toml",
    "yaml",
    "xml",
    "git",
    "git-history"
  ],
  "categories": [
    "Visualization",
    "Other"
  ],
  "bugs": {
    "url": "https://github.com/sharafeddeen/vscode-office/issues"
  },
  "homepage": "https://github.com/sharafeddeen/vscode-office/blob/ahmed/main/docs/AHMED.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/sharafeddeen/vscode-office.git"
  },
  "activationEvents": [
    "onCustomEditor:sharafeddeen.spreadsheetViewer"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "sharafeddeen.spreadsheetViewer",
        "displayName": "Ahmed Spreadsheet Viewer",
        "priority": "default",
        "selector": [
          {
            "filenamePattern": "*.xlsx"
          },
          {
            "filenamePattern": "*.xlsm"
          },
          {
            "filenamePattern": "*.xls"
          },
          {
            "filenamePattern": "*.ods"
          },
          {
            "filenamePattern": "*.csv"
          },
          {
            "filenamePattern": "*.tsv"
          }
        ]
      }
    ],
    "configuration": {
      "title": "Ahmed Spreadsheet Viewer",
      "properties": {
        "ahmedSpreadsheet.backend": {
          "type": "string",
          "enum": [
            "auto",
            "excel",
            "libreoffice",
            "none"
          ],
          "default": "auto",
          "scope": "machine",
          "description": "View saved results immediately. Auto starts LibreOffice UNO only for editing or explicit recalculation; Excel is a read-only calculation fallback."
        },
        "ahmedSpreadsheet.libreOfficePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Optional absolute path to soffice executable."
        },
        "ahmedSpreadsheet.autoCalculateMissing": {
          "type": "boolean",
          "default": false,
          "description": "Opt in to calculating missing saved results after preview loads. Off by default so viewing never starts a calculation backend."
        },
        "ahmedSpreadsheet.timeoutSeconds": {
          "type": "number",
          "default": 90,
          "minimum": 5,
          "maximum": 600,
          "scope": "machine",
          "description": "Native calculation timeout in seconds."
        },
        "ahmedSpreadsheet.pythonPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Optional path to a Python interpreter with LibreOffice UNO bindings. Windows uses LibreOffice bundled Python by default."
        },
        "ahmedSpreadsheet.autoRecalculate": {
          "type": "boolean",
          "default": true,
          "description": "Recalculate the open native document after edits."
        }
      }
    },
    "commands": [
      {
        "command": "ahmedSpreadsheet.clearCache",
        "title": "Ahmed Spreadsheet Viewer: Clear calculation cache"
      }
    ]
  },
  "scripts": {
    "dev": "node scripts/build-spreadsheet.mjs",
    "dev:web": "OFFICE_EXTENSION_TARGET=web vite --mode=development",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "build": "node scripts/build-spreadsheet.mjs",
    "package": "vsce package --no-dependencies --allow-missing-repository",
    "vscode:prepublish": "npm run build",
    "test": "node scripts/run-tests.mjs",
    "test:corpus": "node scripts/run-corpus.mjs",
    "test:integration": "node scripts/run-integration.mjs"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@types/diff-match-patch": "1.0.32",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/vscode": "^1.64.0",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "@vitejs/plugin-react": "^6.0.2",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.7.0",
    "chokidar": "^5.0.0",
    "esbuild": "^0.28.1",
    "esbuild-plugin-copy": "2.1.1",
    "eslint": "^9.39.4",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.7.0",
    "less": "^4.2.0",
    "node-unrar-js": "^2.0.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.16",
    "vite-plugin-static-copy": "^4.1.1"
  },
  "dependencies": {
    "@ant-design/icons": "^5.3.5",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/language": "^6.12.3",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.1",
    "@cweijan/exceljs": "^5.0.3",
    "@eigenpal/docx-editor-react": "^1.9.0",
    "@lezer/highlight": "^1.2.3",
    "@mind-elixir/import-xmind": "^1.0.8",
    "@vscode/codicons": "^0.0.45",
    "@vscode/extension-telemetry": "^1.5.2",
    "@zip.js/zip.js": "^2.8.26",
    "7z-wasm": "^1.2.0",
    "ag-psd": "^30.1.1",
    "antd": "^5.15.4",
    "axios": "^1.18.1",
    "buffer": "^6.0.3",
    "chart.js": "^4.5.1",
    "chrome-finder": "^1.0.7",
    "codemirror": "^6.0.2",
    "codemirror-lang-latex": "^0.4.1",
    "codemirror-lang-mermaid": "^0.5.0",
    "date-format": "^4.0.14",
    "diff-match-patch": "1.0.5",
    "epubjs": "^0.3.93",
    "fast-xml-parser": "^5.3.0",
    "file-type": "^19.6.0",
    "heic2any": "^0.0.4",
    "highlight.js": "^11.10.0",
    "hyparquet": "^1.26.1",
    "hyparquet-writer": "^0.15.7",
    "iconv-lite": "^0.6.3",
    "jszip": "^3.10.1",
    "katex": "^0.16.2",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-checkbox": "^1.1.0",
    "markdown-it-front-matter": "^0.2.4",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-obsidian-callouts": "^0.3.4",
    "markdown-it-plantuml": "^1.4.1",
    "markdown-it-toc-done-right": "^4.2.0",
    "mermaid": "^11.15.0",
    "mind-elixir": "^5.12.2",
    "mustache": "^4.0.1",
    "node-html-parser": "^7.0.1",
    "opentype.js": "1.3.4",
    "pdf-lib": "^1.11.2",
    "pptxviewjs": "^1.1.9",
    "prosemirror-commands": "^1.7.1",
    "prosemirror-dropcursor": "^1.8.2",
    "prosemirror-history": "^1.5.0",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.9",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-transform": "^1.12.0",
    "prosemirror-view": "^1.41.9",
    "puppeteer-core": "^25.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-image-gallery": "^1.3.0",
    "save-svg-as-png": "^1.4.17",
    "tar": "^7.5.16",
    "utif": "^3.1.0",
    "vscode-html-to-docx": "^1.1.3",
    "xlsx": "^0.18.5",
    "yaml": "^2.9.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Saved spreadsheet previews work; native recalculation requires a trusted workspace."
    }
  },
  "license": "MIT"
}
